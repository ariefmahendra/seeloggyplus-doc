---
import DocumentationHeader from '@astrojs/starlight/components/Header.astro';
import LandingHeader from './landing/LandingHeader.astro';

const pathname = Astro.url.pathname.replace(/\/+$/, '');
const isLanding = pathname === '' || pathname === '/id' || Astro.locals.starlightRoute.entry?.data?.template === 'splash';
const locale = Astro.locals.starlightRoute.locale === 'id' ? 'id' : 'en';
---

{isLanding ? <LandingHeader locale={locale} /> : <div class="documentation-header"><DocumentationHeader {...Astro.props} /></div>}

<style>
	.documentation-header {
		height: 100%;
	}
</style>
