---
import { landingCopy, releasesUrl } from '../../content/landing/copy';

type Landing = typeof landingCopy.en;
const { copy, changelogHref } = Astro.props as { copy: Landing; changelogHref: string };
---

<section class="lp-section">
	<div class="lp-wrap">
		<header class="lp-section-head">
			<h2>{copy.download.title}</h2>
			<p>{copy.download.subtitle}</p>
		</header>
		<div class="packages">
			{
				copy.download.packages.map((pkg) => (
					<div class="package">
						<h3>{pkg.name}</h3>
						<p>{pkg.text}</p>
						<a class="lp-btn" href={releasesUrl}>
							{pkg.cta}
						</a>
					</div>
				))
			}
		</div>
		<ul class="notes">
			{copy.download.notes.map((note) => <li>{note}</li>)}
		</ul>
		<div class="actions">
			<a class="lp-btn lp-btn-primary" href={releasesUrl}>{copy.download.primaryCta}</a>
			<a class="changelog" href={changelogHref}>{copy.download.changelog}</a>
		</div>
	</div>
</section>

<style>
	.packages {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
		gap: 1rem;
		margin-bottom: 1.75rem;
	}

	.package {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.55rem;
		padding: 1.5rem;
		border: 1px solid var(--lp-border);
		border-radius: var(--lp-radius);
		background: var(--lp-panel);
	}

	.package h3 {
		margin: 0;
		font-size: 1.05rem;
		font-weight: 650;
	}

	.package p {
		flex: 1;
		margin: 0 0 0.5rem;
		color: var(--lp-muted);
		font-size: 0.9rem;
		line-height: 1.6;
	}

	.notes {
		margin: 0 0 1.75rem;
		padding: 0;
		list-style: none;
		color: var(--lp-muted);
		font-size: 0.875rem;
	}

	.notes li {
		display: flex;
		gap: 0.6rem;
		padding-block: 0.3rem;
	}

	.notes li::before {
		content: '';
		flex: none;
		width: 0.375rem;
		height: 0.375rem;
		margin-top: 0.5rem;
		border-radius: 50%;
		background: var(--lp-brand);
		opacity: 0.55;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1.25rem;
	}

	.changelog {
		color: var(--lp-brand);
		font-size: 0.9rem;
		font-weight: 600;
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.changelog:hover {
		color: var(--lp-brand-hover);
	}
</style>
