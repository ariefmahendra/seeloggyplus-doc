---
import { landingCopy } from '../../content/landing/copy';

type Landing = typeof landingCopy.en;
const { copy } = Astro.props as { copy: Landing };
---

<section class="lp-section facts">
	<div class="lp-wrap">
		<ul class="facts-grid">
			{
				copy.facts.map((fact) => (
					<li>
						<strong>{fact.title}</strong>
						<span>{fact.text}</span>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.facts {
		padding-block: 2.75rem;
	}

	.facts-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
		gap: 1.5rem 2.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.facts-grid li {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		padding-inline-start: 1rem;
		border-inline-start: 2px solid var(--lp-border);
	}

	.facts-grid li:first-child {
		border-inline-start-color: var(--lp-brand);
	}

	.facts-grid strong {
		font-size: 0.95rem;
		font-weight: 650;
	}

	.facts-grid span {
		color: var(--lp-muted);
		font-size: 0.875rem;
		line-height: 1.55;
	}
</style>
