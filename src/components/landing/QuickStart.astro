---
import { landingCopy } from '../../content/landing/copy';

type Landing = typeof landingCopy.en;
const { copy, guideHref } = Astro.props as { copy: Landing; guideHref: string };
---

<section class="lp-section">
	<div class="lp-wrap">
		<header class="lp-section-head">
			<h2>{copy.quickstart.title}</h2>
		</header>
		<ol class="steps">
			{
				copy.quickstart.steps.map((step, index) => (
					<li>
						<span class="step-number" aria-hidden="true">
							{index + 1}
						</span>
						<h3>{step.title}</h3>
						<p>{step.text}</p>
					</li>
				))
			}
		</ol>
		<a class="lp-btn" href={guideHref}>{copy.quickstart.link}</a>
	</div>
</section>

<style>
	.steps {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
		gap: 1.5rem;
		margin: 0 0 2rem;
		padding: 0;
		list-style: none;
		counter-reset: step;
	}

	.steps li {
		position: relative;
		padding-top: 2.75rem;
	}

	.step-number {
		position: absolute;
		top: 0;
		left: 0;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.9rem;
		height: 1.9rem;
		border: 1px solid var(--lp-border);
		border-radius: 0.5rem;
		background: var(--lp-panel);
		color: var(--lp-brand);
		font-family: var(--sl-font-mono);
		font-size: 0.9rem;
	}

	.steps h3 {
		margin: 0 0 0.35rem;
		font-size: 1rem;
		font-weight: 650;
	}

	.steps p {
		margin: 0;
		color: var(--lp-muted);
		font-size: 0.9rem;
		line-height: 1.6;
	}
</style>
