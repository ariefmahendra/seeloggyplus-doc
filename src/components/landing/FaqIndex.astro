---
import { landingCopy } from '../../content/landing/copy';

type Landing = typeof landingCopy.en;
const { copy } = Astro.props as { copy: Landing };
---

<section class="faq">
	<div class="lp-wrap faq-grid">
		<div class="faq-list">
			<p class="faq-heading">{copy.faq.heading}</p>
			<ul role="tablist" aria-orientation="vertical">
				{
					copy.faq.items.map((item, index) => (
						<li data-reveal style={`--i:${index}`}>
							<button
								type="button"
								role="tab"
								class="faq-q"
								data-q
								data-index={index}
								aria-selected={index === 0 ? 'true' : 'false'}
								tabindex={index === 0 ? 0 : -1}
							>
								<span class="dot" aria-hidden="true" />
								{item.q}
							</button>
							<p class="faq-inline" data-inline data-index={index}>{item.a}</p>
						</li>
					))
				}
			</ul>
		</div>
		<div class="faq-pane" data-pane data-reveal style="--i:6">
			{
				copy.faq.items.map((item, index) => (
					<p class="faq-a" data-a data-index={index} hidden={index !== 0}>
						{item.a}
					</p>
				))
			}
		</div>
	</div>
</section>

<script>
	const setupFaq = (section: HTMLElement) => {
		const questions = Array.from(section.querySelectorAll<HTMLButtonElement>('[data-q]'));
		const answers = Array.from(section.querySelectorAll<HTMLElement>('[data-a]'));
		const inline = Array.from(section.querySelectorAll<HTMLElement>('[data-inline]'));
		if (questions.length === 0) return;

		const activate = (index: number, focus: boolean) => {
			questions.forEach((question, questionIndex) => {
				const active = questionIndex === index;
				question.classList.toggle('is-active', active);
				question.setAttribute('aria-selected', String(active));
				question.tabIndex = active ? 0 : -1;
				if (active && focus) question.focus();
			});
			answers.forEach((answer) => {
				answer.hidden = Number(answer.dataset.index) !== index;
			});
			inline.forEach((item) => {
				item.classList.toggle('is-active', Number(item.dataset.index) === index);
			});
		};

		questions.forEach((question, index) => {
			question.addEventListener('click', () => activate(index, false));
			question.addEventListener('focus', () => activate(index, false));
			question.addEventListener('mouseenter', () => activate(index, false));
			question.addEventListener('keydown', (event) => {
				if (event.key === 'ArrowDown') {
					event.preventDefault();
					activate((index + 1) % questions.length, true);
				}
				if (event.key === 'ArrowUp') {
					event.preventDefault();
					activate((index - 1 + questions.length) % questions.length, true);
				}
			});
		});
	};

	document.querySelectorAll<HTMLElement>('.faq').forEach(setupFaq);
</script>

<style>
	.faq {
		padding-block: clamp(5rem, 12vh, 8.5rem);
	}

	.faq-grid {
		display: grid;
		grid-template-columns: 5fr 7fr;
		gap: 4rem;
		align-items: start;
	}

	.faq-heading {
		margin: 0 0 1.1rem;
		color: var(--lp-soft);
		font-size: 1.125rem;
	}

	.faq-list ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.faq-list li {
		margin-bottom: 1.1rem;
	}

	.faq-q {
		border-radius: var(--control-radius);
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
		padding: 0;
		border: 0;
		background: none;
		color: var(--lp-soft);
		font-family: inherit;
		font-size: var(--step-body);
		font-weight: 400;
		line-height: 1.4;
		text-align: left;
		cursor: pointer;
		transition: color var(--t-hover) ease;
	}

	.faq-q .dot {
		flex: none;
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: var(--lp-soft);
		transform: translateY(-0.12em);
		transition: background-color var(--t-hover) ease;
	}

	.faq-q.is-active {
		color: var(--lp-ink);
	}

	.faq-q.is-active .dot {
		background: var(--lp-accent-strong);
	}

	.faq-q:focus-visible {
		outline: 2px solid var(--lp-accent-strong);
		outline-offset: 3px;
	}

	.faq-pane {
		position: sticky;
		top: 7.5rem;
		display: grid;
	}

	.faq-a {
		grid-area: 1 / 1;
		margin: 0;
		max-width: 30ch;
		font-size: var(--step-lead);
		line-height: 1.3;
		color: var(--lp-ink);
		text-wrap: pretty;
		opacity: 0;
		pointer-events: none;
		transition: opacity 150ms ease;
	}

	.faq-a:not([hidden]) {
		opacity: 1;
		pointer-events: auto;
	}

	.faq-inline {
		display: none;
	}

	@media (max-width: 56rem) {
		.faq-grid {
			grid-template-columns: 1fr;
			gap: 0;
		}

		.faq-pane {
			display: none;
		}

		.faq-q {
			font-size: 1.125rem;
		}

		.js .faq-list li {
			margin-bottom: 1.25rem;
		}

		.js .faq-inline {
			display: none;
			margin: 0.6rem 0 0 1.25rem;
			font-size: var(--step-body);
			line-height: 1.5;
			color: var(--lp-ink);
		}

		.js .faq-inline.is-active {
			display: block;
		}
	}
</style>
