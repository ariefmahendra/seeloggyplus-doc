---
import { landingCopy, logLines } from '../../content/landing/copy';

type Landing = typeof landingCopy.en;
const { copy } = Astro.props as { copy: Landing };

const parsed = logLines.slice(0, 8).map((line) => ({
	time: line.slice(0, 23),
	level: line.slice(23, 29).trim(),
	message: line.slice(29).replace(/^- /, ''),
}));
---

<section class="lp-bleed show" data-showcase data-state="rest">
	<div class="lp-wrap show-field">
		<div class="show-top">
			<h2 class="show-heading" data-reveal>
				<span data-head-rest>{copy.showcase.headingRest}</span>
				<span data-head-motion hidden>{copy.showcase.headingMotion}</span>
			</h2>
			<p class="show-sentence" data-reveal style="--i:1">{copy.showcase.sentence}</p>
		</div>
		<ol class="stream" data-ui data-stream aria-hidden="true" data-reveal style="--i:2">
			{
				parsed.map((line) => (
					<li data-level={line.level}>
						<span class="t">{line.time}</span>
						<span class={'lv lv-' + line.level.toLowerCase()}>{line.level.padEnd(5, ' ')}</span>
						<span class="m">{line.message}</span>
					</li>
				))
			}
		</ol>
		<button
			class="switch"
			type="button"
			role="switch"
			aria-checked="false"
			data-switch
			data-ui
			data-reveal
			style="--i:3"
		>
			<span class="switch-track" aria-hidden="true">
				<span class="switch-knob"></span>
			</span>
			<span class="switch-label">{copy.showcase.switchLabel}</span>
			<span
				class="switch-status"
				data-status
				data-on={copy.showcase.statusOn}
				data-off={copy.showcase.statusOff}
			>
				{copy.showcase.statusOff}
			</span>
		</button>
	</div>
</section>

<script>
	const setupShowcase = (section: HTMLElement) => {
		const switchButton = section.querySelector<HTMLButtonElement>('[data-switch]');
		const stream = section.querySelector<HTMLElement>('[data-stream]');
		const status = section.querySelector<HTMLElement>('[data-status]');
		const headRest = section.querySelector<HTMLElement>('[data-head-rest]');
		const headMotion = section.querySelector<HTMLElement>('[data-head-motion]');
		if (!switchButton || !stream) return;

		const source = Array.from(stream.children);

		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		let timer: number | undefined;
		let cursor = 4;
		let visible = false;

		const append = () => {
			const li = source[cursor % source.length].cloneNode(true);
			cursor += 1;
			stream.appendChild(li);
			while (stream.children.length > 11) stream.removeChild(stream.firstElementChild as Element);
			stream.scrollTop = stream.scrollHeight;
		};

		const start = () => {
			if (reduceMotion || timer !== undefined) return;
			timer = window.setInterval(append, 520);
		};

		const stop = () => {
			if (timer !== undefined) {
				window.clearInterval(timer);
				timer = undefined;
			}
		};

		const setState = (on: boolean) => {
			switchButton.setAttribute('aria-checked', String(on));
			section.dataset.state = on ? 'motion' : 'rest';
			if (headRest) headRest.hidden = on;
			if (headMotion) headMotion.hidden = !on;
			if (status) {
				status.textContent = on ? status.dataset.on ?? '' : status.dataset.off ?? '';
			}
			if (on) {
				if (visible) start();
			} else {
				stop();
			}
		};

		switchButton.addEventListener('click', () => {
			const on = switchButton.getAttribute('aria-checked') !== 'true';
			setState(on);
		});

		const observer = new IntersectionObserver((entries) => {
			for (const entry of entries) {
				visible = entry.isIntersecting;
				if (visible) {
					if (switchButton.getAttribute('aria-checked') === 'true') start();
				} else {
					stop();
				}
			}
		});
		observer.observe(section);
	};

	document.querySelectorAll<HTMLElement>('[data-showcase]').forEach(setupShowcase);
</script>

<style>
	.show {
		margin-block: clamp(3rem, 7vh, 5rem);
		background: var(--lp-demo-ground);
		color: var(--lp-demo-ink);
	}

	.show[data-state='motion'] {
		--lp-demo-ground: var(--lp-console-ground);
		--lp-demo-ink: var(--lp-console-ink);
		--lp-demo-soft: var(--lp-console-soft);
	}

	.show-field {
		display: grid;
		gap: 2rem;
		padding-block: clamp(3rem, 7vh, 5rem);
	}

	.show-heading {
		margin: 0 0 0.9rem;
		font-size: var(--step-head);
		font-weight: 500;
		line-height: 1.1;
		letter-spacing: -0.02em;
		text-wrap: balance;
		color: inherit;
	}

	.show-sentence {
		max-width: 52ch;
		margin: 0;
		font-size: var(--step-body);
		line-height: 1.5;
		color: var(--lp-demo-soft);
	}

	.stream {
		height: 16rem;
		margin: 0;
		padding: 0;
		list-style: none;
		overflow: hidden;
		font-family: var(--sl-font-mono); /* taste-skill-ignore */
	}

	.stream li {
		padding: 0.25rem 0;
		font-size: var(--step-small);
		line-height: 1.7;
		white-space: normal;
		overflow-wrap: anywhere;
		color: var(--lp-demo-ink);
	}

	.stream .t {
		color: var(--lp-demo-soft);
	}

	.stream .t,
	.stream .lv {
		margin-inline-end: 0.5em;
	}

	.stream .lv {
		font-weight: 600;
	}

	.stream .lv-info { color: var(--lp-log-info); }
	.stream .lv-debug { color: var(--lp-log-debug); }
	.stream .lv-trace { color: var(--lp-console-soft); }
	.stream .lv-warn { color: var(--lp-log-warn); }
	.stream .lv-error { color: var(--lp-log-error); }

	.show[data-state='rest'] .stream .lv {
		color: var(--lp-demo-ink);
	}

	.switch {
		justify-self: start;
		display: grid;
		grid-template-columns: 4.5rem minmax(0, 1fr);
		align-items: center;
		gap: 0.5rem 1rem;
		max-width: 100%;
		padding: 0.5rem;
		border: 0;
		background: transparent;
		color: inherit;
		font: inherit;
		text-align: start;
		cursor: pointer;
		touch-action: manipulation;
	}

	.switch-track {
		position: relative;
		display: block;
		width: 4.5rem;
		height: 2.5rem;
		border-radius: 999px;
		background: var(--lp-switch-off);
	}

	.switch[aria-checked='true'] .switch-track {
		background: var(--lp-accent);
	}

	.switch-knob {
		position: absolute;
		top: 0.25rem;
		left: 0.25rem;
		width: 2rem;
		height: 2rem;
		border-radius: 50%;
		background: var(--lp-switch-knob);
		transition: transform 240ms var(--ease-out);
	}

	.switch[aria-checked='true'] .switch-knob {
		transform: translateX(2rem);
	}

	.switch-label {
		font-size: var(--step-body);
		font-weight: 600;
	}

	.switch-status {
		grid-column: 1 / -1;
		font-family: var(--sl-font-mono); /* taste-skill-ignore */
		font-size: var(--step-small);
		color: var(--lp-demo-soft);
		overflow-wrap: anywhere;
	}

	.switch:hover .switch-label {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.switch:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: 4px;
	}

	@media (prefers-reduced-motion: reduce) {
		.switch-knob { transition: none; }
	}
</style>
