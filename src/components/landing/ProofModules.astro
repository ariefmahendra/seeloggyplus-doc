---
import { Image } from 'astro:assets';
import fileManager from '../../assets/landing/file-manager.png';
import search from '../../assets/landing/search.png';
import findInFiles from '../../assets/landing/find-in-files.png';
import detail from '../../assets/landing/detail.png';
import serverManagement from '../../assets/landing/server-management.png';
import { landingCopy } from '../../content/landing/copy';

type Landing = typeof landingCopy.en;
const { copy } = Astro.props as { copy: Landing };

const shots: Record<string, ImageMetadata> = {
	'file-manager': fileManager,
	search,
	'find-in-files': findInFiles,
	detail,
	'server-management': serverManagement,
};
---

<section class="lp-bleed features">
	<div class="lp-wrap">
		<h2 class="features-head" data-reveal>{copy.features.heading}</h2>
		<ul class="modules">
			{
				copy.features.modules.map((module, index) => (
					<li class="module" data-reveal style={`--i:${index}`}>
						<div class="panel">
							<Image
								src={shots[module.image]}
								alt={module.alt}
								widths={[560, 760, 1120, 1520, 2280]}
								sizes="(min-width: 64rem) 38rem, calc(100vw - 2.5rem)"
								quality={90}
								loading="lazy"
							/>
						</div>
						<div class="module-text">
							<h3>{module.heading}</h3>
							{module.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
						</div>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.features {
		padding-block: clamp(5rem, 12vh, 8.5rem);
		--lp-ink: #eef1f5;
		--lp-soft: #9aa3af;
		--lp-surface: #171c23;
		background: #10141a;
		color: var(--lp-ink);
	}

	.features-head {
		margin: 0 0 4rem;
		font-size: var(--step-head);
		font-weight: 500;
		line-height: 1;
		letter-spacing: -0.02em;
		color: inherit;
	}

	.modules {
		display: grid;
		gap: clamp(4rem, 10vh, 7rem);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.module {
		display: grid;
		grid-template-columns: minmax(0, 38rem) minmax(0, 22rem);
		gap: 2rem;
		max-width: 66rem;
	}

	.panel {
		background: var(--lp-surface);
	}

	.panel :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}

	.module-text {
		max-width: 24rem;
	}

	.module-text h3 {
		margin: 0 0 0.5rem;
		font-size: var(--step-body);
		font-weight: 500;
		line-height: 1.35;
		color: inherit;
	}

	.module-text p {
		margin: 0 0 0.6rem;
		max-width: 60ch;
		color: var(--lp-soft);
		font-size: var(--step-body);
		line-height: 1.55;
	}

	@media (max-width: 48rem) {
		.module {
			grid-template-columns: 1fr;
			gap: 1.25rem;
		}

		.module-text {
			max-width: none;
		}

		.features-head {
			margin-bottom: 2.5rem;
		}
	}
</style>
