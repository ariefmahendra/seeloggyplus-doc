---
import { Image } from 'astro:assets';
import fileManager from '../../assets/landing/file-manager-dark.png';
import remoteBrowser from '../../assets/landing/remote-browser-dark.png';
import tail from '../../assets/landing/tail-dark.png';
import search from '../../assets/landing/search-dark.png';
import detail from '../../assets/landing/detail-dark.png';
import findInFiles from '../../assets/landing/find-in-files-dark.png';
import preferences from '../../assets/landing/preferences-dark.png';
import serverManagement from '../../assets/landing/server-management-dark.png';
import { landingCopy } from '../../content/landing/copy';

type Landing = typeof landingCopy.en;
const { copy } = Astro.props as { copy: Landing };

const images: Record<string, ImageMetadata> = {
	'file-manager': fileManager,
	'remote-browser': remoteBrowser,
	tail,
	search,
	detail,
	'find-in-files': findInFiles,
	preferences,
	'server-management': serverManagement,
};
---

<section id="screenshots" class="gallery lp-bleed">
	<div class="lp-wrap lp-media-wrap">
		<div class="carousel" data-gallery data-reveal style="--i:1">
			<div class="gallery-toolbar">
				<header class="gallery-head">
					<h2>{copy.gallery.heading}</h2>
					<p>{copy.gallery.subtitle}</p>
				</header>
				<div class="controls">
					<button type="button" class="arrow" data-prev aria-label={copy.gallery.prev}>
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<polyline points="15 18 9 12 15 6"></polyline>
						</svg>
					</button>
					<div class="dots">
						{
							copy.gallery.slides.map((slide, index) => (
								<button
									type="button"
									class="dot"
									data-dot
									data-index={index}
									aria-label={slide.title}
									aria-current={index === 0 ? 'true' : 'false'}
								/>
							))
						}
					</div>
					<span class="counter" data-counter>{`1 / ${copy.gallery.slides.length}`}</span>
					<button type="button" class="arrow" data-next aria-label={copy.gallery.next}>
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<polyline points="9 18 15 12 9 6"></polyline>
						</svg>
					</button>
				</div>
			</div>
			<div class="track" data-track tabindex="0" role="group" aria-label={copy.gallery.heading}>
				{
					copy.gallery.slides.map((slide) => (
						<figure class="slide" data-slide>
							<a
								class="slide-media"
								href={images[slide.image].src}
								target="_blank"
								rel="noopener"
							>
								<Image
									src={images[slide.image]}
									alt={slide.alt}
									widths={[640, 960, 1440, 1920, 2880]}
									sizes="(min-width: 50rem) min(1296px, calc(177.777vh - 23.111rem), 96vw), 100vw"
									quality={90}
									loading="lazy"
								/>
							</a>
							<figcaption>
								<strong>{slide.title}</strong>
								<span>{slide.text}</span>
							</figcaption>
						</figure>
					))
				}
			</div>
		</div>
	</div>
</section>

<script>
	const setupGallery = (gallery: HTMLElement) => {
		const track = gallery.querySelector<HTMLElement>('[data-track]');
		if (!track) return;

		const slides = Array.from(gallery.querySelectorAll<HTMLElement>('[data-slide]'));
		const dots = Array.from(gallery.querySelectorAll<HTMLButtonElement>('[data-dot]'));
		const counter = gallery.querySelector<HTMLElement>('[data-counter]');
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		let glideFrame: number | undefined;
		let navigation = 0;
		let navigating = false;
		const prepareImage = async (index: number) => {
			const image = slides[index]?.querySelector('img');
			if (!image) return;
			image.loading = 'eager';
			await image.decode().catch(() => {});
		};

		const cancelGlide = () => {
			if (glideFrame !== undefined) {
				cancelAnimationFrame(glideFrame);
				glideFrame = undefined;
			}
			track.removeAttribute('data-gliding');
		};

		const glideTo = (target: number) => {
			if (reduceMotion) {
				track.scrollLeft = target;
				track.removeAttribute('data-gliding');
				navigating = false;
				return;
			}
			cancelGlide();
			const from = track.scrollLeft;
			const distance = target - from;
			if (Math.abs(distance) < 1) {
				track.removeAttribute('data-gliding');
				navigating = false;
				return;
			}
			const duration = 550;
			const started = performance.now();
			const easeInOut = (progress: number) =>
				progress < 0.5 ? 4 * progress * progress * progress : 1 - Math.pow(-2 * progress + 2, 3) / 2;
			track.setAttribute('data-gliding', 'true');
			const frame = (now: number) => {
				const progress = Math.min(1, (now - started) / duration);
				track.scrollLeft = from + distance * easeInOut(progress);
				if (progress < 1) {
					glideFrame = requestAnimationFrame(frame);
				} else {
					glideFrame = undefined;
					navigating = false;
					track.removeAttribute('data-gliding');
				}
			};
			glideFrame = requestAnimationFrame(frame);
		};

		const interrupt = () => {
			navigation += 1;
			navigating = false;
			cancelGlide();
		};
		track.addEventListener('pointerdown', interrupt, { passive: true });
		track.addEventListener('wheel', interrupt, { passive: true });

		const setCurrent = (index: number) => {
			dots.forEach((dot, dotIndex) => {
				const isCurrent = dotIndex === index;
				dot.classList.toggle('is-current', isCurrent);
				dot.setAttribute('aria-current', isCurrent ? 'true' : 'false');
			});
			if (counter) counter.textContent = `${index + 1} / ${slides.length}`;
		};

		const goTo = async (index: number) => {
			const clamped = Math.max(0, Math.min(slides.length - 1, index));
			const request = ++navigation;
			navigating = true;
			cancelGlide();
			track.setAttribute('data-gliding', 'true');
			setCurrent(clamped);
			await prepareImage(clamped);
			if (request !== navigation) return;
			void prepareImage(clamped + 1);
			void prepareImage(clamped - 1);
			const slide = slides[clamped];
			if (slide) {
				const trackRect = track.getBoundingClientRect();
				const slideRect = slide.getBoundingClientRect();
				const target =
					track.scrollLeft + (slideRect.left - trackRect.left) - (track.clientWidth - slideRect.width) / 2;
				glideTo(target);
			}
			setCurrent(clamped);
		};

		const currentIndex = () => dots.findIndex((dot) => dot.classList.contains('is-current'));

		gallery.querySelector('[data-prev]')?.addEventListener('click', () => goTo(currentIndex() - 1));
		gallery.querySelector('[data-next]')?.addEventListener('click', () => goTo(currentIndex() + 1));

		dots.forEach((dot) => {
			dot.addEventListener('click', () => goTo(Number(dot.dataset.index ?? 0)));
		});

		track.addEventListener('keydown', (event) => {
			if (event.key === 'ArrowLeft') {
				event.preventDefault();
				goTo(currentIndex() - 1);
			}
			if (event.key === 'ArrowRight') {
				event.preventDefault();
				goTo(currentIndex() + 1);
			}
		});

		const observer = new IntersectionObserver(
			(entries) => {
				if (navigating) return;
				for (const entry of entries) {
					if (entry.isIntersecting && entry.intersectionRatio > 0.6) {
						setCurrent(slides.indexOf(entry.target as HTMLElement));
					}
				}
			},
			{ root: track, threshold: [0.6] }
		);
		slides.forEach((slide) => observer.observe(slide));
		void prepareImage(0);
		void prepareImage(1);
	};

	document.querySelectorAll<HTMLElement>('[data-gallery]').forEach(setupGallery);
</script>

<style>
	.gallery {
		padding-block: clamp(5rem, 12vh, 8.5rem);
		--lp-ink: #eef1f5;
		--lp-soft: #9aa3af;
		--lp-surface: #171c23;
		background: #10141a;
		color: var(--lp-ink);
	}

	.gallery .lp-media-wrap {
		max-width: min(var(--lp-media-width), calc(177.777svh - 20.111rem));
	}

	.gallery-toolbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		margin-bottom: 1rem;
	}

	.gallery-head {
		margin: 0;
	}

	.gallery-head h2 {
		margin: 0 0 0.5rem;
		font-size: clamp(1.75rem, 2.5vw, 2rem);
		font-weight: 500;
		line-height: 1;
		letter-spacing: -0.02em;
		color: inherit;
	}

	.gallery-head p {
		max-width: 44ch;
		margin: 0;
		color: var(--lp-soft);
		font-size: var(--step-body);
	}

	.track {
		display: flex;
		gap: 1.25rem;
		overflow-x: auto;
		overscroll-behavior-x: contain;
		scroll-behavior: auto;
		scroll-snap-type: x mandatory;
		scroll-padding-inline: 0;
		padding-block: 0.25rem;
		scrollbar-width: none;
	}

	.track::-webkit-scrollbar {
		display: none;
	}

	.track[data-gliding] {
		scroll-snap-type: none;
	}

	.slide {
		flex: 0 0 100%;
		margin: 0;
		scroll-snap-align: center;
	}

	.slide-media {
		display: block;
	}

	.slide-media :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}

	.slide figcaption {
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
		margin-top: 0.75rem;
		font-size: var(--step-small);
	}

	.slide figcaption strong {
		font-weight: 500;
	}

	.slide figcaption span {
		color: var(--lp-soft);
	}

	.controls {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin: 0;
		flex-shrink: 0;
	}

	.arrow {
		border-radius: var(--control-radius);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		border: 0;
		background: var(--lp-accent);
		color: #ffffff;
		cursor: pointer;
		transition: background-color var(--t-hover) ease, transform var(--t-press) var(--ease-out);
	}

	@media (hover: hover) and (pointer: fine) {
		.arrow:hover {
			background: var(--lp-accent-strong);
		}
	}

	.arrow:active {
		transform: scale(0.97);
	}

	.arrow svg {
		width: 1.1rem;
		height: 1.1rem;
	}

	.dots {
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}

	.dots > .dot {
		margin: 0;
		width: 0.5rem;
		height: 0.5rem;
		padding: 0;
		border: 0;
		border-radius: 999px;
		background: color-mix(in srgb, var(--lp-soft) 45%, transparent);
		cursor: pointer;
		transition: background-color var(--t-hover) ease, width var(--t-ui) var(--ease-out);
	}

	.dot.is-current {
		width: 1.35rem;
		background: var(--lp-accent);
	}

	.counter {
		margin-left: auto;
		color: var(--lp-soft);
		font-size: var(--step-small);
		font-variant-numeric: tabular-nums;
	}

	.track:focus-visible,
	.arrow:focus-visible,
	.dot:focus-visible {
		outline: 2px solid var(--lp-accent-strong);
		outline-offset: 3px;
	}

	@media (max-width: 60rem) {
		.gallery-toolbar {
			align-items: stretch;
			flex-direction: column;
			gap: 1rem;
		}
	}

	@media (max-width: 48rem) {
		.slide figcaption {
			flex-direction: column;
			gap: 0.15rem;
		}
	}
</style>
