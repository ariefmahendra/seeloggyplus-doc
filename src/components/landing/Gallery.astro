---
import { Image } from 'astro:assets';
import fileManager from '../../assets/landing/file-manager.png';
import remoteBrowser from '../../assets/landing/remote-browser.png';
import tail from '../../assets/landing/tail.png';
import search from '../../assets/landing/search.png';
import detail from '../../assets/landing/detail.png';
import findInFiles from '../../assets/landing/find-in-files.png';
import preferences from '../../assets/landing/preferences.png';
import serverManagement from '../../assets/landing/server-management.png';
import { landingCopy } from '../../content/landing/copy';

type Landing = typeof landingCopy.en;
const { copy } = Astro.props as { copy: Landing };

const images: Record<string, ImageMetadata> = {
	'file-manager': fileManager,
	'remote-browser': remoteBrowser,
	tail,
	search,
	detail,
	'find-in-files': findInFiles,
	preferences,
	'server-management': serverManagement,
};
---

<section class="gallery lp-bleed">
	<div class="lp-wrap">
		<header class="gallery-head" data-reveal>
			<h2>{copy.gallery.heading}</h2>
			<p>{copy.gallery.subtitle}</p>
		</header>
		<div class="carousel" data-gallery data-reveal style="--i:1">
			<div class="track" data-track tabindex="0" role="group" aria-label={copy.gallery.heading}>
				{
					copy.gallery.slides.map((slide) => (
						<figure class="slide" data-slide>
							<a
								class="slide-media"
								href={images[slide.image].src}
								target="_blank"
								rel="noopener"
							>
								<Image
									src={images[slide.image]}
									alt={slide.alt}
									widths={[640, 960, 1440, 1920, 2880]}
									sizes="(min-width: 60rem) 56rem, 92vw"
									quality={90}
									loading="lazy"
								/>
							</a>
							<figcaption>
								<strong>{slide.title}</strong>
								<span>{slide.text}</span>
							</figcaption>
						</figure>
					))
				}
			</div>
			<div class="controls">
				<button type="button" class="arrow" data-prev aria-label={copy.gallery.prev}>
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<polyline points="15 18 9 12 15 6"></polyline>
					</svg>
				</button>
				<div class="dots">
					{
						copy.gallery.slides.map((slide, index) => (
							<button
								type="button"
								class="dot"
								data-dot
								data-index={index}
								aria-label={slide.title}
								aria-current={index === 0 ? 'true' : 'false'}
							/>
						))
					}
				</div>
				<span class="counter" data-counter>{`1 / ${copy.gallery.slides.length}`}</span>
				<button type="button" class="arrow" data-next aria-label={copy.gallery.next}>
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<polyline points="9 18 15 12 9 6"></polyline>
					</svg>
				</button>
			</div>
		</div>
	</div>
</section>

<script>
	const setupGallery = (gallery: HTMLElement) => {
		const track = gallery.querySelector<HTMLElement>('[data-track]');
		if (!track) return;

		const slides = Array.from(gallery.querySelectorAll<HTMLElement>('[data-slide]'));
		const dots = Array.from(gallery.querySelectorAll<HTMLButtonElement>('[data-dot]'));
		const counter = gallery.querySelector<HTMLElement>('[data-counter]');
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		const setCurrent = (index: number) => {
			dots.forEach((dot, dotIndex) => {
				const isCurrent = dotIndex === index;
				dot.classList.toggle('is-current', isCurrent);
				dot.setAttribute('aria-current', isCurrent ? 'true' : 'false');
			});
			if (counter) counter.textContent = `${index + 1} / ${slides.length}`;
		};

		const goTo = (index: number) => {
			const clamped = Math.max(0, Math.min(slides.length - 1, index));
			const slide = slides[clamped];
			if (slide) {
				const trackRect = track.getBoundingClientRect();
				const slideRect = slide.getBoundingClientRect();
				const target =
					track.scrollLeft + (slideRect.left - trackRect.left) - (track.clientWidth - slideRect.width) / 2;
				track.scrollTo({
					left: target,
					behavior: reduceMotion ? 'auto' : 'smooth',
				});
			}
			setCurrent(clamped);
		};

		const currentIndex = () => dots.findIndex((dot) => dot.classList.contains('is-current'));

		gallery.querySelector('[data-prev]')?.addEventListener('click', () => goTo(currentIndex() - 1));
		gallery.querySelector('[data-next]')?.addEventListener('click', () => goTo(currentIndex() + 1));

		dots.forEach((dot) => {
			dot.addEventListener('click', () => goTo(Number(dot.dataset.index ?? 0)));
		});

		track.addEventListener('keydown', (event) => {
			if (event.key === 'ArrowLeft') {
				event.preventDefault();
				goTo(currentIndex() - 1);
			}
			if (event.key === 'ArrowRight') {
				event.preventDefault();
				goTo(currentIndex() + 1);
			}
		});

		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting && entry.intersectionRatio > 0.6) {
						setCurrent(slides.indexOf(entry.target as HTMLElement));
					}
				}
			},
			{ root: track, threshold: [0.6] }
		);
		slides.forEach((slide) => observer.observe(slide));
	};

	document.querySelectorAll<HTMLElement>('[data-gallery]').forEach(setupGallery);
</script>

<style>
	.gallery {
		padding-block: clamp(5rem, 12vh, 8.5rem);
	}

	.gallery-head {
		margin-bottom: 2.5rem;
	}

	.gallery-head h2 {
		margin: 0 0 0.5rem;
		font-size: var(--step-head);
		font-weight: 500;
		line-height: 1;
		letter-spacing: -0.02em;
	}

	.gallery-head p {
		max-width: 44ch;
		margin: 0;
		color: var(--lp-soft);
		font-size: var(--step-body);
	}

	.track {
		display: flex;
		gap: 1.25rem;
		overflow-x: auto;
		overscroll-behavior-x: contain;
		scroll-snap-type: x mandatory;
		scroll-padding-inline: 0.25rem;
		padding-block: 0.25rem;
		scrollbar-width: none;
	}

	.track::-webkit-scrollbar {
		display: none;
	}

	.slide {
		flex: 0 0 min(56rem, 88%);
		margin: 0;
		scroll-snap-align: center;
	}

	.slide-media {
		display: block;
	}

	.slide-media :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}

	.slide figcaption {
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
		margin-top: 0.75rem;
		font-size: var(--step-small);
	}

	.slide figcaption strong {
		font-weight: 500;
	}

	.slide figcaption span {
		color: var(--lp-soft);
	}

	.controls {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-top: 1.75rem;
	}

	.arrow {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		border: 0;
		background: var(--lp-accent);
		color: #ffffff;
		cursor: pointer;
		transition: background-color var(--t-hover) ease, transform var(--t-press) var(--ease-out);
	}

	@media (hover: hover) and (pointer: fine) {
		.arrow:hover {
			background: var(--lp-accent-strong);
		}
	}

	.arrow:active {
		transform: scale(0.97);
	}

	.arrow svg {
		width: 1.1rem;
		height: 1.1rem;
	}

	.dots {
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}

	.dot {
		width: 0.5rem;
		height: 0.5rem;
		padding: 0;
		border: 0;
		border-radius: 999px;
		background: color-mix(in srgb, var(--lp-soft) 45%, transparent);
		cursor: pointer;
		transition: background-color var(--t-hover) ease, width var(--t-ui) var(--ease-out);
	}

	.dot.is-current {
		width: 1.35rem;
		background: var(--lp-accent);
	}

	.counter {
		margin-left: auto;
		color: var(--lp-soft);
		font-size: var(--step-small);
		font-variant-numeric: tabular-nums;
	}

	.track:focus-visible,
	.arrow:focus-visible,
	.dot:focus-visible {
		outline: 2px solid var(--lp-accent-strong);
		outline-offset: 3px;
	}

	@media (max-width: 48rem) {
		.slide {
			flex-basis: 92%;
		}

		.slide figcaption {
			flex-direction: column;
			gap: 0.15rem;
		}
	}
</style>
