---
import { Image } from 'astro:assets';
import heroDark from '../../assets/landing/hero-dark.png';
import { landingCopy, releasesUrl } from '../../content/landing/copy';

type Landing = typeof landingCopy.en;
const { copy, guideHref } = Astro.props as { copy: Landing; guideHref: string };
---

<section class="hero lp-bleed">
	<div class="lp-wrap">
		<div class="hero-copy">
			<h1 class="hero-title">
				<span class="line"><span style="--li:0">{copy.hero.headline[0]}</span></span>
				<span class="line"><span style="--li:1">{copy.hero.headline[1]}</span></span>
			</h1>
			<p class="hero-sentence" data-rise style="--i:0">{copy.hero.sentence}</p>
			<div class="hero-actions" data-rise style="--i:1">
				<a class="lp-btn lp-focus" href={releasesUrl}>{copy.hero.button}</a>
				<a class="lp-link lp-focus" href={guideHref}>{copy.hero.link}</a>
			</div>
			<p class="hero-note" data-rise style="--i:2">{copy.hero.note}</p>
		</div>
	</div>
	<div class="lp-wrap lp-media-wrap stage-outer">
		<div class="hero-stage">
			<div class="hero-stage-body">
				<div class="hero-stage-shot">
					<Image
						class="hero-shot hero-shot-dark"
						src={heroDark}
						alt={copy.hero.alt}
						widths={[720, 1080, 1440, 2160, 2880]}
						sizes="(min-width: 50rem) min(1296px, 146vh, 96vw), 100vw"
						quality={90}
						loading="eager"
						fetchpriority="high"
					/>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		overflow: clip;
		padding-top: clamp(1.75rem, 5vh, 3rem);
	}

	.hero-copy {
		position: relative;
		max-width: 46rem;
	}

	.hero-title {
		margin: 0 0 1.1rem;
		max-width: 12ch;
		font-size: var(--step-display);
		font-weight: 700;
		line-height: 0.95;
		letter-spacing: -0.02em;
		text-wrap: balance;
	}

	.hero-title .line {
		display: block;
		overflow: hidden;
		padding-bottom: 0.07em;
		margin-bottom: -0.07em;
	}

	.hero-title .line > span {
		display: block;
	}

	@media (prefers-reduced-motion: no-preference) {
		:global(.js) .hero-title .line > span {
			transform: translateY(105%);
			animation: lp-line-up 900ms var(--ease-out) forwards;
			animation-delay: calc(var(--li, 0) * 110ms + 150ms);
		}
	}

	.hero-sentence {
		max-width: 34ch;
		margin: 0 0 1.75rem;
		color: var(--lp-ink);
		font-size: var(--step-lead);
		line-height: 1.35;
		text-wrap: pretty;
	}

	.hero-actions {
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}

	.hero-note {
		max-width: 44ch;
		margin: 1.1rem 0 0;
		color: var(--lp-soft);
		font-size: var(--step-small);
	}

	.stage-outer {
		position: relative;
		margin-top: clamp(1.5rem, 4.5vh, 3rem);
	}

	.hero-stage-body {
		padding: 1rem;
		background: var(--lp-stage);
		clip-path: polygon(1rem 0, 100% 0, 100% 100%, 0 100%, 0 1rem);
	}

	.hero-stage-shot {
		position: relative;
	}

	.hero-stage-shot :global(img),
	.hero-stage-shot img {
		display: block;
		width: 100%;
		height: auto;
	}

	@media (prefers-reduced-motion: no-preference) {
		.hero-stage {
			animation: lp-shutter 1100ms var(--ease-in-out) 200ms both;
		}

		.hero-stage-body {
			animation: lp-settle-body 1500ms var(--ease-soft) 200ms both;
		}
	}

	@supports (animation-timeline: view()) {
		@media (prefers-reduced-motion: no-preference) {
			.hero-stage-shot img {
				animation: lp-drift linear both;
				animation-timeline: view();
				animation-range: entry 0% exit 100%;
			}
		}
	}

</style>

<style is:global>
	@keyframes lp-line-up {
		to {
			transform: none;
		}
	}

	@keyframes lp-shutter {
		from {
			clip-path: inset(0 0 0 100%);
		}

		to {
			clip-path: inset(0);
		}
	}

	@keyframes lp-settle-body {
		from {
			transform: scale(1.06);
		}

		to {
			transform: none;
		}
	}

	@keyframes lp-drift {
		from {
			transform: translateY(-3%);
		}

		to {
			transform: translateY(3%);
		}
	}
</style>
