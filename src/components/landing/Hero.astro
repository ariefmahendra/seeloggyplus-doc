---
import { Image } from 'astro:assets';
import heroLight from '../../assets/landing/hero-light.png';
import heroDark from '../../assets/landing/hero-dark.png';
import { landingCopy, releasesUrl, repositoryUrl } from '../../content/landing/copy';

type Landing = typeof landingCopy.en;
const { copy, guideHref } = Astro.props as { copy: Landing; guideHref: string };
---

<section class="hero">
	<div class="lp-wrap hero-inner">
		<p class="hero-badge">
			<span class="hero-version">{copy.hero.version}</span>
			{copy.hero.versionNote}
		</p>
		<h1>{copy.hero.headline}</h1>
		<p class="hero-lede">{copy.hero.lede}</p>
		<div class="hero-cta">
			<a class="lp-btn lp-btn-primary" href={releasesUrl}>{copy.hero.download}</a>
			<a class="lp-btn" href={guideHref}>{copy.hero.guide}</a>
			<a class="lp-btn lp-btn-ghost" href={repositoryUrl}>{copy.hero.github}</a>
		</div>
		<ul class="hero-meta">
			{copy.hero.meta.map((item) => <li>{item}</li>)}
		</ul>
	</div>
	<div class="lp-wrap">
		<figure class="shot">
			<span class="shot-rail" aria-hidden="true"></span>
			<div class="shot-frame">
				<Image
					class="shot-img shot-light"
					src={heroLight}
					alt={copy.hero.alt}
					widths={[720, 1080, 1440, 2160, 2880]}
					sizes="(min-width: 76rem) 1168px, 100vw"
					loading="eager"
					fetchpriority="high"
				/>
				<Image
					class="shot-img shot-dark"
					src={heroDark}
					alt=""
					aria-hidden="true"
					widths={[720, 1080, 1440, 2160, 2880]}
					sizes="(min-width: 76rem) 1168px, 100vw"
					loading="lazy"
				/>
				<div class="shot-strip">
					{copy.hero.captionChips.map((chip) => <span class="chip">{chip}</span>)}
					<span class="hint">{copy.hero.captionHint}</span>
				</div>
			</div>
		</figure>
	</div>
</section>

<style>
	.hero {
		position: relative;
		padding-block: 4rem 3rem;
	}

	.hero::before {
		content: '';
		position: absolute;
		inset: -7rem 0 auto;
		height: 38rem;
		background: radial-gradient(80rem 32rem at 50% -6rem, var(--lp-brand-tint), transparent 72%);
		pointer-events: none;
	}

	.hero-inner {
		position: relative;
		max-width: 48rem;
		margin-bottom: 2.75rem;
	}

	.hero-badge {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin: 0 0 1.1rem;
		color: var(--lp-muted);
		font-size: 0.85rem;
	}

	.hero-version {
		padding: 0.1rem 0.5rem;
		border: 1px solid var(--lp-border);
		border-radius: 0.4rem;
		background: var(--lp-panel);
		color: var(--lp-ink);
		font-family: var(--sl-font-mono);
		font-size: 0.8rem;
	}

	.hero h1 {
		margin: 0 0 1.1rem;
		font-size: clamp(2.4rem, 6vw, 3.8rem);
		font-weight: 800;
		line-height: 1.04;
		letter-spacing: -0.025em;
	}

	.hero-lede {
		max-width: 40rem;
		margin: 0 0 1.75rem;
		color: var(--lp-muted);
		font-size: 1.1rem;
		line-height: 1.65;
	}

	.hero-cta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-bottom: 1.5rem;
	}

	.hero-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
		color: var(--lp-muted);
		font-size: 0.85rem;
	}

	.hero-meta li {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.hero-meta li::before {
		content: '';
		width: 0.375rem;
		height: 0.375rem;
		border-radius: 50%;
		background: var(--lp-brand);
		opacity: 0.55;
	}

	.shot {
		position: relative;
		display: flex;
		gap: 0.75rem;
		margin: 0;
	}

	.shot-rail {
		flex: none;
		width: 3px;
		border-radius: 2px;
		background: linear-gradient(
			to bottom,
			var(--lp-success),
			var(--lp-success) 30%,
			var(--lp-warning) 55%,
			var(--lp-danger)
		);
		opacity: 0.75;
	}

	.shot-frame {
		flex: 1;
		min-width: 0;
		border: 1px solid var(--lp-border);
		border-radius: var(--lp-radius);
		background: var(--lp-panel);
		overflow: hidden;
		box-shadow: 0 32px 64px -40px rgb(0 0 0 / 0.35);
	}

	.shot-img {
		display: block;
		width: 100%;
		height: auto;
	}

	:global([data-theme='light']) .shot-dark {
		display: none;
	}

	:global([data-theme='dark']) .shot-light {
		display: none;
	}

	.shot-strip {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 0.75rem;
		border-top: 1px solid var(--lp-border);
		background: var(--lp-bg-soft);
		font-size: 0.8rem;
	}

	.chip {
		padding: 0.1rem 0.5rem;
		border: 1px solid var(--lp-border);
		border-radius: 0.375rem;
		background: var(--lp-panel);
		font-family: var(--sl-font-mono);
		font-size: 0.75rem;
	}

	.hint {
		margin-inline-start: auto;
		color: var(--lp-muted);
		font-family: var(--sl-font-mono);
		font-size: 0.75rem;
	}

	@media (max-width: 48rem) {
		.hero {
			padding-block: 2.5rem 2rem;
		}

		.hint {
			display: none;
		}
	}
</style>
