---
const accessibleLabel = Astro.locals.t('themeSelect.accessibleLabel');
const darkLabel = Astro.locals.t('themeSelect.dark');
const lightLabel = Astro.locals.t('themeSelect.light');
const autoLabel = Astro.locals.t('themeSelect.auto');
---

<starlight-theme-select>
	<select class="sr-only" aria-label={accessibleLabel} tabindex="-1">
		<option value="auto">{autoLabel}</option>
		<option value="dark">{darkLabel}</option>
		<option value="light">{lightLabel}</option>
	</select>

	<details class="theme-dropdown header-dropdown">
		<summary class="dropdown-trigger" aria-label={accessibleLabel}>
			<span class="trigger-icon">
				<svg class="dropdown-svg theme-icon icon-auto" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="12" x="3" y="4" rx="2"/><line x1="2" x2="22" y1="20" y2="20"/></svg>
				<svg class="dropdown-svg theme-icon icon-light" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
				<svg class="dropdown-svg theme-icon icon-dark" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
			</span>
			<span class="trigger-label">{autoLabel}</span>
			<svg class="trigger-caret" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
		</summary>
		<ul class="dropdown-menu" role="listbox">
			<li>
				<button type="button" class="dropdown-item" data-theme-val="auto" role="option">
					<span class="item-icon">
						<svg class="dropdown-svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="12" x="3" y="4" rx="2"/><line x1="2" x2="22" y1="20" y2="20"/></svg>
					</span>
					<span class="item-label">{autoLabel}</span>
					<svg class="check-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
				</button>
			</li>
			<li>
				<button type="button" class="dropdown-item" data-theme-val="light" role="option">
					<span class="item-icon">
						<svg class="dropdown-svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
					</span>
					<span class="item-label">{lightLabel}</span>
					<svg class="check-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
				</button>
			</li>
			<li>
				<button type="button" class="dropdown-item" data-theme-val="dark" role="option">
					<span class="item-icon">
						<svg class="dropdown-svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
					</span>
					<span class="item-label">{darkLabel}</span>
					<svg class="check-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
				</button>
			</li>
		</ul>
	</details>
</starlight-theme-select>

<script is:inline>
	StarlightThemeProvider.updatePickers();
</script>

<script>
	type Theme = 'auto' | 'dark' | 'light';
	const storageKey = 'starlight-theme';

	const parseTheme = (theme: unknown): Theme =>
		theme === 'auto' || theme === 'dark' || theme === 'light' ? theme : 'auto';

	const loadTheme = (): Theme =>
		parseTheme(typeof localStorage !== 'undefined' && localStorage.getItem(storageKey));

	function storeTheme(theme: Theme): void {
		if (typeof localStorage !== 'undefined') {
			localStorage.setItem(storageKey, theme === 'light' || theme === 'dark' ? theme : '');
		}
	}

	const getPreferredColorScheme = (): Theme =>
		matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';

	function applyTheme(theme: Theme): void {
		StarlightThemeProvider.updatePickers(theme);
		document.documentElement.dataset.theme = theme === 'auto' ? getPreferredColorScheme() : theme;
		storeTheme(theme);
		syncThemeUI(theme);
	}

	function syncThemeUI(theme: Theme): void {
		document.querySelectorAll<HTMLElement>('starlight-theme-select').forEach((el) => {
			const select = el.querySelector<HTMLSelectElement>('select');
			if (select && select.value !== theme) {
				select.value = theme;
			}
			const details = el.querySelector<HTMLDetailsElement>('details');
			if (!details) return;
			details.dataset.currentTheme = theme;
			details.querySelectorAll<HTMLButtonElement>('.dropdown-item').forEach((btn) => {
				const isSelected = btn.dataset.themeVal === theme;
				btn.setAttribute('aria-selected', isSelected ? 'true' : 'false');
				if (isSelected) {
					const label = details.querySelector('.trigger-label');
					const text = btn.querySelector('.item-label')?.textContent;
					if (label && text) label.textContent = text;
				}
			});
		});
	}

	matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
		if (loadTheme() === 'auto') applyTheme('auto');
	});

	class StarlightThemeSelect extends HTMLElement {
		constructor() {
			super();
			applyTheme(loadTheme());

			const details = this.querySelector<HTMLDetailsElement>('details');
			const select = this.querySelector<HTMLSelectElement>('select');

			select?.addEventListener('change', (e) => {
				if (e.currentTarget instanceof HTMLSelectElement) {
					applyTheme(parseTheme(e.currentTarget.value));
				}
			});

			this.querySelectorAll<HTMLButtonElement>('.dropdown-item').forEach((btn) => {
				btn.addEventListener('click', (e) => {
					e.stopPropagation();
					const val = parseTheme(btn.dataset.themeVal);
					applyTheme(val);
					if (details) details.open = false;
				});
			});

			details?.addEventListener('toggle', () => {
				if (details.open) {
					document.querySelectorAll<HTMLDetailsElement>('details.header-dropdown[open]').forEach((other) => {
						if (other !== details) other.open = false;
					});
				}
			});

			document.addEventListener('click', (e) => {
				if (details?.open && !this.contains(e.target as Node)) {
					details.open = false;
				}
			});

			details?.addEventListener('keydown', (e) => {
				if (e.key === 'Escape') {
					details.open = false;
					details.querySelector('summary')?.focus();
				}
			});
		}
	}
	customElements.define('starlight-theme-select', StarlightThemeSelect);
</script>
