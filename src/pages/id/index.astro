---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import LandingMotion from '../../components/landing/LandingMotion.astro';
import Hero from '../../components/landing/Hero.astro';
import ProofModules from '../../components/landing/ProofModules.astro';
import Showcase from '../../components/landing/Showcase.astro';
import Gallery from '../../components/landing/Gallery.astro';
import LineJourney from '../../components/landing/LineJourney.astro';
import FaqIndex from '../../components/landing/FaqIndex.astro';
import CtaClose from '../../components/landing/CtaClose.astro';
import { landingCopy } from '../../content/landing/copy';

const copy = landingCopy.id;
---

<StarlightPage
	frontmatter={{ title: copy.meta.title, description: copy.meta.description, template: 'splash' }}
	hasSidebar={false}
	lang="id"
>
	<LandingMotion />
	<div class="lp">
		<Hero copy={copy} guideHref="/id/getting-started/" />
		<ProofModules copy={copy} />
		<Showcase copy={copy} />
		<Gallery copy={copy} />
		<LineJourney copy={copy} />
		<FaqIndex copy={copy} />
		<CtaClose copy={copy} guideHref="/id/getting-started/" changelogHref="/id/changelog/" />
	</div>
</StarlightPage>
